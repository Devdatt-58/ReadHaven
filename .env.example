# Copy this file to .env and fill in the values. Never commit the real .env.

# PostgreSQL with the pgvector extension (Neon, Supabase, or a local Docker image).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Used by robots.ts, sitemap.ts and layout.tsx for absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional OAuth providers — leave blank to disable them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional — enables the LLM-powered Awards category recommendations.
GROQ_API_KEY=""
